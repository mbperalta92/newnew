<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="gold-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#BF953F"/>
      <stop offset="25%" stop-color="#FCF6BA"/>
      <stop offset="50%" stop-color="#B38728"/>
      <stop offset="75%" stop-color="#FBF5B7"/>
      <stop offset="100%" stop-color="#AA771C"/>
    </linearGradient>
    <linearGradient id="bg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B1325"/>
      <stop offset="100%" stop-color="#050812"/>
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg-grad)"/>
  <!-- Gold accent border -->
  <rect width="1176" height="606" x="12" y="12" rx="24" fill="none" stroke="url(#gold-grad)" stroke-width="4" opacity="0.3"/>
  <!-- Grid overlay -->
  <g opacity="0.05" stroke="#BF953F" stroke-width="1">
    <line x1="0" y1="100" x2="1200" y2="100"/>
    <line x1="0" y1="200" x2="1200" y2="200"/>
    <line x1="0" y1="300" x2="1200" y2="300"/>
    <line x1="0" y1="400" x2="1200" y2="400"/>
    <line x1="0" y1="500" x2="1200" y2="500"/>
    <line x1="200" y1="0" x2="200" y2="630"/>
    <line x1="400" y1="0" x2="400" y2="630"/>
    <line x1="600" y1="0" x2="600" y2="630"/>
    <line x1="800" y1="0" x2="800" y2="630"/>
    <line x1="1000" y1="0" x2="1000" y2="630"/>
  </g>
  <!-- Emblem Icon -->
  <g transform="translate(180, 315) scale(1.8)">
    <circle cx="0" cy="0" r="65" fill="none" stroke="url(#gold-grad)" stroke-width="8" stroke-dasharray="260 30" opacity="0.85"/>
    <path fill="url(#gold-grad)" d="M -30 -38 L 10 -38 C 25 -38 35 -28 35 -16 C 35 -4 25 5 10 5 L -10 5 L -10 38 L -30 38 Z M -10 -15 L 8 -15 C 15 -15 18 -18 18 -24 C 18 -30 15 -33 8 -33 L -10 -33 Z"/>
    <path fill="url(#gold-grad)" d="M 3 3 L 30 38 L 10 38 L -14 5 Z"/>
  </g>
  <!-- Text Content -->
  <text x="340" y="270" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="72" fill="url(#gold-grad)" letter-spacing="4">REPFIX</text>
  <text x="340" y="325" font-family="system-ui, -apple-system, sans-serif" font-weight="600" font-size="28" fill="#FFFFFF" letter-spacing="2">SERVIÇOS TÉCNICOS</text>
  <text x="340" y="380" font-family="system-ui, -apple-system, sans-serif" font-weight="400" font-size="22" fill="#94A3B8">Diagnóstico Eletrónico · Assistência Técnica · Relatórios Técnicos</text>
  <text x="340" y="440" font-family="system-ui, -apple-system, sans-serif" font-weight="500" font-size="18" fill="#BF953F">www.repfix.pt</text>
</svg>
